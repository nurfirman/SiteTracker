// Prisma Schema for SiteTracker CMD
// Configured for Serverless Neon PostgreSQL

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  CMD
  PIC
  SM
  PM
  GM
  BOD
  ADMIN
  PENDING
}

enum Category {
  K3_SAFETY
  QUALITY
  KEBERSIHAN_5R
  SCHEDULE
  MATERIAL
}

enum FindingStatus {
  OPEN
  RESOLVED
  CLOSED
}

model Project {
  id        String    @id @default(uuid())
  code      String?   @unique @db.VarChar(50)
  name      String    @db.VarChar(255)
  location  String    @db.VarChar(255)
  division  String?   @db.VarChar(100)
  pmId      String?   @map("pm_id")
  pm        User?     @relation("ProjectPM", fields: [pmId], references: [id], onDelete: SetNull)
  gmId      String?   @map("gm_id")
  gm        User?     @relation("ProjectGM", fields: [gmId], references: [id], onDelete: SetNull)
  createdAt DateTime  @default(now()) @map("created_at")

  users     User[]
  findings  Finding[]

  @@map("projects")
}

model User {
  id          String   @id @default(uuid())
  name        String   @db.VarChar(255)
  email       String   @unique @db.VarChar(255)
  role        Role
  phoneNumber String   @map("phone_number") @db.VarChar(50)
  projectId   String?  @map("project_id")
  project     Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)

  projectsManagedAsPm Project[] @relation("ProjectPM")
  projectsManagedAsGm Project[] @relation("ProjectGM")

  findingsAssigned Finding[] @relation("PicFindings")
  findingsReported Finding[] @relation("ReporterFindings")

  @@map("users")
}

model Finding {
  id                 String        @id @default(uuid())
  ticketCode         String        @unique @map("ticket_code") @db.VarChar(50)
  projectId          String        @map("project_id")
  project            Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  picId              String        @map("pic_id")
  pic                User          @relation("PicFindings", fields: [picId], references: [id])
  reporterId         String        @map("reporter_id")
  reporter           User          @relation("ReporterFindings", fields: [reporterId], references: [id])
  locationDetail     String        @map("location_detail") @db.VarChar(255)
  coordinates        String?       @db.VarChar(100)
  category           Category
  description        String        @db.Text
  photoFindingUrl    String        @map("photo_finding_url") @db.Text
  status             FindingStatus @default(OPEN)
  picResponse        String?       @map("pic_response") @db.Text
  photoResolutionUrl String?       @map("photo_resolution_url") @db.Text
  rejectionNote      String?       @map("rejection_note") @db.Text
  reportNumber       String?       @map("report_number") @db.VarChar(100)
  createdAt          DateTime      @default(now()) @map("created_at")
  dueDate            DateTime?     @map("due_date")
  resolvedAt         DateTime?     @map("resolved_at")
  closedAt           DateTime?     @map("closed_at")

  @@index([projectId])
  @@index([picId])
  @@index([status])
  @@index([category])
  @@index([reportNumber])
  @@map("findings")
}

model PatrolReport {
  id                String   @id @default(uuid())
  reportNumber      String   @unique @map("report_number") @db.VarChar(100)
  inspectorName     String   @map("inspector_name") @db.VarChar(255)
  reportDate        String   @map("report_date") @db.VarChar(50)
  projectName       String   @map("project_name") @db.VarChar(255)
  projectId         String?  @map("project_id")
  siteManagerName   String   @map("site_manager_name") @db.VarChar(255)
  picName           String   @map("pic_name") @db.VarChar(255)
  picId             String?  @map("pic_id")
  inspectionType    String   @map("inspection_type") @db.VarChar(100)
  presentInspectors String?  @map("present_inspectors") @db.VarChar(255)
  recipients        String?  @db.Text
  subject           String?  @db.VarChar(255)
  messageNote       String?  @map("message_note") @db.Text
  findingsCount     Int?     @default(0) @map("findings_count")
  createdAt         DateTime @default(now()) @map("created_at")

  @@index([reportNumber])
  @@index([reportDate])
  @@index([projectId])
  @@map("patrol_reports")
}

