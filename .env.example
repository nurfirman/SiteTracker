# =======================================================
# KONFIGURASI DATABASE SERVERLESS NEON POSTGRESQL
# =======================================================
# Dapatkan string koneksi dari Dashboard Neon (https://neon.tech)
# Format: postgresql://[user]:[password]@[ep-host].neon.tech/[dbname]?sslmode=require
#DATABASE_URL="postgresql://neondb_owner:your_password_here@ep-example-123456.ap-southeast-1.aws.neon.tech/neondb?sslmode=require"
DATABASE_URL="postgresql://neondb_owner:your_password_here@ep-example-123456.ap-southeast-1.aws.neon.tech/neondb?sslmode=require"
# Direct URL untuk migration Prisma (opsional jika menggunakan pooler)
DIRECT_URL="postgresql://neondb_owner:your_password_here@ep-example-123456.ap-southeast-1.aws.neon.tech/neondb?sslmode=require"

# =======================================================
# STORAGE FOTO (PILIHAN: Vercel Blob / Cloudinary / Base64 Fallback)
# =======================================================
# Vercel Blob Token (jika menggunakan Vercel Blob Storage)
BLOB_READ_WRITE_TOKEN="vercel_blob_rw_xxxxxxxx"

# Cloudinary (jika menggunakan Cloudinary)
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME="your_cloud_name"
CLOUDINARY_API_KEY="your_api_key"
CLOUDINARY_API_SECRET="your_api_secret"

# =======================================================
# APP CONFIG
# =======================================================
NEXT_PUBLIC_APP_NAME="SiteTracker CMD"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ====================================================================
# MICROSOFT AZURE / ENTRA ID OAUTH 2.0 (MICROSOFT GRAPH API MAIL)
# ====================================================================
# 1. Directory (tenant) ID dari Azure Portal (Overview > App registrations)
AZURE_TENANT_ID="your_tenant_id_here"

# 2. Application (client) ID dari Azure App Registration
AZURE_CLIENT_ID="your_client_id_here"

# 3. Client Secret Value dari Certificates & secrets (Value, BUKAN Secret ID)
AZURE_CLIENT_SECRET="your_client_secret_value_here"

# 4. Alamat email akun pengirim resmi Microsoft 365 / Exchange
AZURE_SENDER_EMAIL="no-reply@yourdomain.com"

# ====================================================================
# NEON AUTH (MANAGED BETTER AUTH / SERVERLESS POSTGRES AUTH)
# ====================================================================
# 1. Base URL Neon Auth dari tab "Auth" di Neon Console (https://console.neon.tech)
# Contoh: https://auth.neon.tech/neondb_xxxx atau domain auth kustom
NEON_AUTH_BASE_URL=""

# 2. Secret Cookie untuk enkripsi & signing session token Neon Auth
NEON_AUTH_COOKIE_SECRET=""

